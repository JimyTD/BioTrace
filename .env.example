# Copy to apps/api/.env (or repo root — API loads apps/api/.env)

PORT=8787
HOST=127.0.0.1

# Required for cookie signing
SESSION_SECRET=dev-change-me-to-a-long-random-string

# Cut 1: enable one-click fake login
DEV_AUTH=1

# SQLite + local uploads (relative to apps/api cwd or absolute)
DATABASE_URL=file:../../data/biotrace.db
UPLOAD_DIR=../../data/uploads

# Gemini (preferred identify)
GEMINI_API_KEY=
# 钉死 3.6，不要用 gemini-flash-latest（会漂到最新 Flash，免费层易 503）
GEMINI_MODEL=gemini-3.6-flash

# TokenHub 在线推理：稀有度量表 + 识图回退共用这一个 Key，只换模型名。
# 不要填 Coding Plan 的 sk-sp- Key（套餐 Key 不能用于 API）。
# TOKENHUB_API_KEY=
# TOKENHUB_BASE_URL=https://tokenhub.tencentmaas.com/v1
# 识图回退视觉链（Gemini 日额耗尽后按序试）。免费额度用尽就降下一档。
# IDENTIFY_VL_MODELS=glm-5v-turbo,kimi-k2.6,hy-vision-2.0-instruct

# 稀有度量表（见 docs/SPEC.md §3）
# 模型优先级链，按序试，某档配额耗尽或鉴权失败就打冷却降到下一档。
# RARITY_TEXT_MODELS=glm-5.3,glm-5.2,kimi-k3,glm-5.1
# 每物种采样次数（1 次采样 = 3 次调用）。
# RARITY_SAMPLES=1
# 得分离档位界不超过这个距离就补采样到 RARITY_EDGE_SAMPLES，别让一道噪声题决定档位。
# RARITY_EDGE_MARGIN=0.2
# RARITY_EDGE_SAMPLES=3
# 量表题只要判断不要推理链；开 thinking 在免费档极易撞限流。
# RARITY_THINKING=1
# 同一物种相邻两批之间的间隔，避开免费档约 1 req/s 的限制。
# RARITY_CALL_DELAY_MS=1200

# Identify resilience
IDENTIFY_CONCURRENCY=1
IDENTIFY_GEMINI_WAIT_MAX_MS=90000
IDENTIFY_JOB_DEADLINE_MS=900000
# Per-account platform-key identify cap (UTC day). 0 = unlimited.
IDENTIFY_DAILY_LIMIT=100
# Local guardrail tests: fixed mock identify, no cloud vision / encounter GLM.
# IDENTIFY_MOCK=1

# Auth (Cut 5) — magic link via Resend
# APP_ORIGIN=http://127.0.0.1:5173
# RESEND_API_KEY=
# MAIL_FROM=BioTrace <onboarding@resend.dev>
# DEV_AUTH=1

# Production (see deploy/.env.production.example and docs/OPS.md)
# CORS_ORIGIN=https://your.domain
# COOKIE_SECURE=1
# NODE_ENV=production
# DEV_AUTH=0

# 天地图**服务端** key：逆地理编码（坐标 → 国家），国别判定的线上优先路径。
# 与前端瓦片用的浏览器端 key 是两个不同的应用，不可混用（服务端 key 调瓦片会被拒，反之亦然）。
# 申请：https://console.tianditu.gov.cn/ → 应用管理 → 创建应用（服务端）
# 留空则国别判定只走离线国界数据，功能不受影响（精度略低）。
TIANDITU_SERVER_KEY=

# Optional outbound proxy for Gemini from restricted networks
# 注意：天地图是国内服务，其请求已在代码里显式直连、不受此代理影响。
# HTTPS_PROXY=http://127.0.0.1:7890

# Display image longest edge (px)
DISPLAY_MAX_EDGE=1600

# Admin console (/admin) — bootstrap when admin_users is empty (password ≥ 8)
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_PASSWORD=adminadmin
# BIOTRACE_BACKUP_DIR=
