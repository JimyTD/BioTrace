# Copy to deploy/.env.production on the server (never commit secrets).

SESSION_SECRET=replace-with-a-long-random-string
# Production: keep 0. Local/debug only: 1
DEV_AUTH=0

# Public site origin (no trailing slash) — magic links + CORS must match.
APP_ORIGIN=https://biotrace.example.com
CORS_ORIGIN=https://biotrace.example.com

# Behind HTTPS Nginx (same-site /api proxy) — keep Secure cookies on.
COOKIE_SECURE=1
NODE_ENV=production

# Resend magic-link email (verify domain in Resend dashboard)
RESEND_API_KEY=
MAIL_FROM=BioTrace <login@your-verified-domain.com>

# Gemini (via Singapore proxy if needed)
GEMINI_API_KEY=
# Pin 3.6 — do not use gemini-flash-latest (tracks newest Flash, free-tier 503s)
GEMINI_MODEL=gemini-3.6-flash
HTTPS_PROXY=http://127.0.0.1:7890

# TokenHub（稀有度量表 + 识图回退，国内直连）
TOKENHUB_API_KEY=
# TOKENHUB_BASE_URL=https://tokenhub.tencentmaas.com/v1
# IDENTIFY_VL_MODELS=glm-5v-turbo,kimi-k2.6,hy-vision-2.0-instruct

GBIF_ENABLED=1
IDENTIFY_CONCURRENCY=1
# Per-account platform-key identify cap (UTC day). 0 = unlimited.
IDENTIFY_DAILY_LIMIT=100
# Never enable in production unless debugging: skips cloud vision + encounter GLM.
# IDENTIFY_MOCK=1
DISPLAY_MAX_EDGE=1600

# 天地图服务端 key（逆地理编码：坐标 → 国家）。留空则只走离线国界数据。
# 国内服务，代码里显式直连，不走上面的 HTTPS_PROXY。
TIANDITU_SERVER_KEY=

# 天地图浏览器端（瓦片）。也可写 VITE_TIANDITU_* 同名；Admin 可覆盖并经 /api/map/tianditu-keys 下发。
# TIANDITU_BROWSER_KEY=
# TIANDITU_BROWSER_KEY_FALLBACK=
# TIANDITU_BROWSER_KEY_FALLBACK_2=

# Admin console bootstrap (only used when admin_users table is empty)
# ADMIN_BOOTSTRAP_USERNAME=admin
# ADMIN_BOOTSTRAP_PASSWORD=change-me-at-least-8-chars
# Optional: directory to show latest backup file status in admin storage page
# BIOTRACE_BACKUP_DIR=/root

# Android 侧载包目录（默认与 db 同级 android-release；容器内 /data/android-release）
# ANDROID_RELEASE_DIR=/data/android-release

