# Copy to deploy/.env.production on the server (never commit secrets).

SESSION_SECRET=replace-with-a-long-random-string
# Production: keep 0. Local/debug only: 1
DEV_AUTH=0

# Public site origin (no trailing slash) — magic links + CORS must match.
APP_ORIGIN=https://biotrace.example.com
CORS_ORIGIN=https://biotrace.example.com

# Behind HTTPS Nginx (same-site /api proxy) — keep Secure cookies on.
COOKIE_SECURE=1
NODE_ENV=production

# Resend magic-link email (verify domain in Resend dashboard)
RESEND_API_KEY=
MAIL_FROM=BioTrace <login@your-verified-domain.com>

# Gemini (via Singapore proxy if needed)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
HTTPS_PROXY=http://127.0.0.1:7890

# Zhipu GLM fallback (often reachable without proxy from CN)
ZHIPU_API_KEY=
ZHIPU_VL_MODEL=glm-4v-flash
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4

GBIF_ENABLED=1
IDENTIFY_CONCURRENCY=1
# Per-account platform-key identify cap (UTC day). 0 = unlimited.
IDENTIFY_DAILY_LIMIT=100
# Never enable in production unless debugging: skips cloud vision + encounter GLM.
# IDENTIFY_MOCK=1
DISPLAY_MAX_EDGE=1600

# 天地图服务端 key（逆地理编码：坐标 → 国家）。留空则只走离线国界数据。
# 国内服务，代码里显式直连，不走上面的 HTTPS_PROXY。
TIANDITU_SERVER_KEY=
