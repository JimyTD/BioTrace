# Install as /etc/nginx/sites-available/biotrace then symlink into sites-enabled.
# Replace biotrace.example.com and certificate paths after certbot.

server {
    listen 80;
    listen [::]:80;
    server_name biotrace.example.com;

    # Certbot will add ACME + redirect; until then you can proxy HTTP for smoke tests.
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name biotrace.example.com;

    ssl_certificate     /etc/letsencrypt/live/biotrace.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/biotrace.example.com/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    client_max_body_size 20m;

    root /var/www/biotrace;
    index index.html;

    location /api/ {
        proxy_pass http://127.0.0.1:8787;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 300s;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
