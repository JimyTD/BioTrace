# Install as /etc/nginx/sites-available/biotrace then symlink into sites-enabled.
# Replace biotrace.example.com and certificate paths after certbot.

server {
    listen 80;
    listen [::]:80;
    server_name biotrace.example.com;

    # Certbot will add ACME + redirect; until then you can proxy HTTP for smoke tests.
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name biotrace.example.com;

    ssl_certificate     /etc/letsencrypt/live/biotrace.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/biotrace.example.com/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    client_max_body_size 20m;

    root /var/www/biotrace;
    index index.html;

    location /api/ {
        proxy_pass http://127.0.0.1:8787;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 300s;
    }

    # 带哈希的产物可以长期缓存，但**缺失时必须 404**：
    # 部署用 rsync --delete 清掉旧哈希文件，若被下面的 SPA 兜底成 HTML，
    # 客户端拿 HTML 当 JS/CSS 解析，页面只剩空背景且不会报错。
    location /assets/ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    # index.html 绝不缓存：它记着当前哈希，过期副本会指向已删除的产物。
    # Android WebView 没有 Cache-Control 时会按启发式缓存数小时，必须显式关掉。
    location = /index.html {
        add_header Cache-Control "no-store";
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
