# 复制为 .env 后填写。不要提交 .env。
# 哪个有 key 就测哪个；空着的提供方会自动跳过。

# —— Google Gemini（https://aistudio.google.com/apikey）——
GEMINI_API_KEY=
# 可选；新账号可用 gemini-flash-latest / gemini-3-flash-preview
GEMINI_MODEL=gemini-flash-latest

# —— 智谱（与 QQBotForFun 海龟汤同一开放平台 Key）——
# https://open.bigmodel.cn/ → API Key
# 海龟汤用文本 glm-4-flash；识图请用视觉免费模型，如：
#   glm-4v-flash / glm-4.1v-thinking-flash / glm-4.6v-flash（以控制台为准）
ZHIPU_API_KEY=
ZHIPU_VL_MODEL=glm-4v-flash
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# —— 火山方舟 · 豆包（https://console.volcengine.com/ark）——
# 在方舟创建推理接入点，把 Endpoint ID 填到 DOUBAO_MODEL
ARK_API_KEY=
DOUBAO_MODEL=
# 一般不用改
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# —— 阿里云百炼 · 通义 VL（https://bailian.console.aliyun.com/）——
DASHSCOPE_API_KEY=
# 例：qwen-vl-plus / qwen-vl-max / qwen3-vl-plus（以控制台为准）
QWEN_VL_MODEL=qwen-vl-plus
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# —— 可选：OpenAI ——
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# —— 可选：Anthropic Claude ——
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
