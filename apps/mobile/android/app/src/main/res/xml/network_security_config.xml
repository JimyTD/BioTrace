<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Cut 6：备案前 IP + HTTP；备案 HTTPS 后可收紧为仅系统信任 + 禁 cleartext -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
