# app runtime data (repo root only — not apps/api/data seeds)
/data/
!/data/.gitkeep

# node
node_modules/
dist/
*.tsbuildinfo
.turbo/

# python
.venv/
**/__pycache__/
*.pyc
.Python

# rarity calibration script outputs
apps/api/scripts/out/

# introduced-index build cache (GRIIS Compendium CSV ~24MB)
apps/api/data/_cache/

# 骨架中文配表中间缓存（可续跑，不入库）
scripts/_cache/

# 名录原始件（公开政府文件，合计约 9MB）。list.json 与 SOURCE.md 照常入库；
# 下载地址写在各目录 SOURCE.md，要重跑解析脚本时再取回。
apps/api/data/cn-*/*.pdf
apps/api/data/cn-*/*.html

# bakeoff outputs & local caches
model-bakeoff/results/
model-bakeoff/images/*.jpg
model-bakeoff/images/*.jpeg
model-bakeoff/images/*.png
model-bakeoff/images/*.webp
model-bakeoff/images/*.heic
!model-bakeoff/images/.gitkeep
!model-bakeoff/images/manifest.example.yaml

# 本地走查截图（无头浏览器出的图，不入库）
.shot/
# 走查工具自己的运行目录 / 图片生成工具的落地目录
.playwright-cli/
generated-images/

# 本地走查用的两张辅助页：换会话、跳过引导、量零件盒子。
# 放在 public/ 才同源，但不该跟着构建产物发出去
apps/web/public/dev-login.html
apps/web/public/measure.html

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
*.log

# Cursor MCP 本地凭据（只提交 mcp.json.example）
.cursor/mcp.json
